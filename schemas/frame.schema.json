{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/CLDMV/slothlet-vine/schemas/frame.schema.json",
	"title": "slothlet-vine frame (v1)",
	"description": "The wire frames exchanged over a Channel. Unknown frame types are ignored by receivers (forward compatibility).",
	"oneOf": [
		{
			"type": "object",
			"required": ["type", "v", "leaves"],
			"properties": {
				"type": { "const": "surface" },
				"v": { "const": 1 },
				"leaves": { "type": "array", "items": { "type": "string" } },
				"context": {
					"const": true,
					"description": "present only when the serve accepts a per-call requested context (#79); an older grow ignores it"
				}
			}
		},
		{
			"type": "object",
			"required": ["type", "callId", "path", "args"],
			"properties": {
				"type": { "const": "call" },
				"callId": { "type": "string", "minLength": 1 },
				"path": { "type": "string", "description": "dotted leaf path exactly as served, e.g. exts.pdfViewer.open" },
				"args": { "type": "array" },
				"context": {
					"type": "object",
					"description": "optional per-call REQUESTED context (#79): plain data, never identity; accepted, narrowed or refused by the serve's context check. Sent only to a serve whose surface advertised context: true"
				}
			}
		},
		{
			"type": "object",
			"required": ["type", "callId"],
			"properties": {
				"type": { "const": "result" },
				"callId": { "type": "string", "minLength": 1 },
				"value": {}
			}
		},
		{
			"type": "object",
			"required": ["type", "callId", "error"],
			"properties": {
				"type": { "const": "error" },
				"callId": { "type": "string", "minLength": 1 },
				"error": {
					"type": "object",
					"required": ["name", "message"],
					"properties": {
						"name": { "type": "string" },
						"message": { "type": "string" },
						"code": { "type": "string" },
						"stack": { "type": "string" }
					}
				}
			}
		}
	]
}
